msgid "DDNS"
msgstr "DDNS"

msgid "Control the DDNS service here. Providers, records, notifications, logs and Web accounts are configured in the DDNS Web console."
msgstr "在此控制 DDNS 服務。服務商、解析記錄、通知、日誌和 Web 帳號請在 DDNS Web 控制台中設定。"

msgid "Service settings"
msgstr "服務設定"

msgid "Enable"
msgstr "啟用"

msgid "Web port"
msgstr "Web 連接埠"

msgid "Running status"
msgstr "運行狀態"

msgid "Open Web console"
msgstr "開啟 Web 管理"

msgid "The DDNS console listens on the configured port. It accepts loopback and RFC1918 private IPv4 clients."
msgstr "DDNS 控制台監聽設定的連接埠，僅接受本機和 RFC1918 私有 IPv4 用戶端。"

msgid "DDNS is running"
msgstr "DDNS 運行中"

msgid "DDNS is not running"
msgstr "DDNS 未運行"
