#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled

	config_load ddns-web
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	[ -f /etc/ddns/config.yaml ] || {
		mkdir -p /etc/ddns
		printf 'providers: []\nwebhook:\n  headers: []\n' > /etc/ddns/config.yaml
		chmod 600 /etc/ddns/config.yaml
	}

	procd_open_instance
	procd_set_param command /usr/bin/ddns -web -c /etc/ddns/config.yaml -p 8686
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/ddns-web /etc/ddns/config.yaml
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ddns-web
}

reload_service() {
	stop
	start
}
